+#!/usr/bin/env python3
+"""Build SSC-CHSL/2023/2023-08-03_Shift-4.json from the Adda247 CBE export (09181137).
+All data captured verbatim from the 4-chunk fetch of
+https://www.adda247.com/jobs/wp-content/uploads/sites/22/2025/07/09181137/SSC-CHSL-2023-03-08-2023-Shift-IV-Paper.pdf
+(document order: chunk0 -> chunk1 -> chunk3 -> chunk2; chunk boundaries verified continuous)."""
+import json
+
+NR = '[NOT RECOVERABLE: rendered as image in source PDF]'
+OPTS_NR = {'A': NR, 'B': NR, 'C': NR, 'D': NR}
+ABS_Q = ("[NOT RECOVERABLE: question block (stem, options, SSC Question ID and Status line) absent from the "
+         "source PDF's parsed text layer - no text recovered from the corresponding pages; see notes]")
+
+A = 'Candidate response in CBE export: Status Answered, Chosen Option {c} (reference only, not authoritative).'
+NA = 'Candidate response in CBE export: Status Not Answered (reference only, not authoritative).'
+NARF = 'Candidate response in CBE export: Status Not Attempted and Marked For Review, Chosen Option -- (reference only, not authoritative).'
+ACUT = 'Candidate response in CBE export: Status Answered (chosen option cut off in parsed layer) (reference only, not authoritative).'
+NOST = 'No Status/Chosen line present in parsed text layer.'
+CEMPTY = 'Chosen Option line present but empty in parsed layer; no Status line recovered.'
+IDMISS = 'No Question ID/Status line present in parsed text layer (the Question-ID line fell on a page boundary in the source parse).'
+ABSN = 'No Question ID/Status line present in parsed text layer (question block absent from parsed layer; see notes).'
+
+EN = 'English Language'
+GI = 'General Intelligence and Reasoning'
+QA = 'Quantitative Aptitude'
+GA = 'General Awareness'
+
+PASSAGE = ("Comprehension:\n"
+           "In the following passage some words have been deleted. Read the passage carefully and select the most appropriate option to fill in each blank.\n"
+           "The Grim Reaper seems to have (1)_______ in Europe during the 14th century. It was during this time that Europe was dealing with "
+           "what was then the world\u2019s (2)_______ pandemic, the Black Death, believed to be the result of the plague. It is estimated that about "
+           "one-third of Europe\u2019s entire population (3)_________ as a result of the pandemic, with some areas of the continent suffering far greater "
+           "losses than others. The original outbreak of the plague occurred during 1347\u201351, and outbreaks then (4)________ several other times after that. "
+           "So, clearly, death was something that the surviving Europeans had on their mind, and it is not surprising that they (5)_______ an image to represent it.")
+
+qs = []
+def add(num, subj, qid, text, opts, note):
+    qs.append({'question_number': num, 'subject': subj, 'question_id': qid, 'question': text,
+               'options': opts, 'correct_answer': None, 'answer_source': None, 'answer_note': note})
+
+# ---------------- English 1-25 ----------------
+add(1, EN, '264330149744',
+    "Choose the correct meaning of the underlined word in the given sentence.\nThe orchard was a peaceful retreat, with the sound of leaves rustling in the wind and birds chirping in the trees.",
+    {'A': 'A piece of land with lots of houses', 'B': 'A collection of farmlands', 'C': NR, 'D': NR}, NOST)
+add(2, EN, '264330142634',
+    "Select the most appropriate meaning of the given idiom.\nMake up one\u2019s mind",
+    {'A': NR, 'B': NR, 'C': 'To decide', 'D': 'To cheat'}, NOST)
+add(3, EN, '264330144329',
+    "Select the grammatically correct version of the following sentence.\nI like my puppies, Mac and Matt, but I like Matt best.",
+    {'A': 'I like my puppies, Mac and Matt, but I like Matt better.',
+     'B': 'I like my puppies, Mac and Matt, but I like Matt the best.', 'C': NR, 'D': NR}, NOST)
+add(4, EN, '264330143947',
+    'Select the most appropriate meaning of the underlined phrase in the following sentence.\nAs the actors gathered backstage, the director shouted, \u201cBreak a leg, everyone!\u201d before they took the stage for their opening night performance.',
+    {'A': 'To get a good night\'s sleep', 'B': 'To wish someone good luck', 'C': 'To take a risk', 'D': 'To keep a secret'}, A.format(c=2))
+add(5, EN, '264330143957',
+    "Select the most appropriate ANTONYM to replace the underlined word in the following sentence.\nHe was a liberal who believed that men were inherently superior to women in every aspect of life.",
+    {'A': 'conservative', 'B': 'tolerant', 'C': 'republican', 'D': 'philanthropist'}, A.format(c=1))
+add(6, EN, '264330150831',
+    "Select the most appropriate option that can substitute the underlined segment in the following sentence. If there is no need to substitute it, select 'No substitution required'.\nI enjoy learn languages because I like them.",
+    {'A': 'to learning', 'B': 'lean', 'C': 'learning', 'D': 'No substitution required'}, A.format(c=3))
+add(7, EN, '264330149862',
+    "Select the option that can be used as a one-word substitute for the given group of words.\nArgue loudly about unimportant things",
+    {'A': 'Maintain', 'B': 'Disagree', 'C': 'Agree', 'D': 'Squabble'}, A.format(c=4))
+add(8, EN, '264330143220',
+    "Select the most appropriate ANTONYM of the given word.\nHostile",
+    {'A': 'Hospitable', 'B': 'Bitter', 'C': 'Nasty', 'D': 'Aggressive'}, A.format(c=1))
+add(9, EN, '264330147608',
+    "Select the option that expresses the given sentence in passive voice.\nDo the Basus visit the Shuklas?",
+    {'A': 'Are the Shuklas been visited by the Basus?', 'B': 'Are the Shuklas visit by the Basus?',
+     'C': 'Are the Shuklas being visited by the Basus?', 'D': 'Are the Shuklas visited by the Basus?'}, A.format(c=4))
+add(10, EN, '264330143948',
+    "Select the correctly spelt word.",
+    {'A': 'Occasion', 'B': 'Occasion', 'C': 'Occasien', 'D': 'Occassion'}, A.format(c=2))
+add(11, EN, '264330149870',
+    "Select the most appropriate synonym of the underlined word.\nHe was the discreet boy in our group but more hardworking than all of us.",
+    {'A': 'loud', 'B': 'outspoken', 'C': 'reserved', 'D': 'noisy'}, A.format(c=3))
+add(12, EN, '264330142657',
+    "Select the most appropriate synonym of the bracketed word in the following sentence to fill in the blank.\nThe factory has been ________(exhaling) black smoke from its chimney.",
+    {'A': 'emitting', 'B': 'preserving', 'C': 'remitting', 'D': 'indicting'}, A.format(c=1))
+add(13, EN, '264330143167',
+    "Select the option that can be used as a one-word substitute for the given group of words.\nA life history of a person written by himself",
+    {'A': 'Biography', 'B': 'Epic', 'C': 'Story', 'D': 'Autobiography'}, A.format(c=4))
+add(14, EN, '264330143918',
+    "Parts of a sentence are given below in jumbled order. Select the option that arranges the parts in the correct order to form a meaningful sentence.\nA) about all his\nB) noise they make\nC) he constantly complains\nD) neighbours and the",
+    {'A': 'B, A, D, C', 'B': 'C, A, D, B', 'C': 'B, D, A, C', 'D': 'D, B, C, A'}, A.format(c=2))
+add(15, EN, None,
+    "Select the option that expresses the given sentence in active voice.\nI was kept waiting for more than an hour to get an appointment by the staff.",
+    {'A': 'The staff had kept me waiting for more than an hour to get an appointment.',
+     'B': 'The staff keep me waiting for more than an hour to get an appointment.',
+     'C': 'The staff kept me waiting for more than an hour to get an appointment.',
+     'D': 'The staff kept me wait for more than an hour to get an appointment.'}, IDMISS)
+add(16, EN, '264330144341',
+    "Sentences of a paragraph are given below in jumbled order. Select the option that arranges the sentences in the correct logical sequence to form a meaningful and coherent paragraph.\n"
+    "A. Globally, almost 6.5 million people have died so far.\n"
+    "B. As I write the final chapter, we enter the third year in our battle with COVID-19.\n"
+    "C. While we have the vaccine to outlive the disease, to live our grief needs the salve of time.\n"
